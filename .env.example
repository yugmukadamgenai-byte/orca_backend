# Copy this file to .env for local development, or set these as
# Environment Variables in Render's dashboard for production.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
PUSH_API_KEY=change-this-to-a-long-random-string-too

# Render sets DATABASE_URL automatically when you attach a free Postgres
# instance - you don't need to set this yourself in production.
# DATABASE_URL=postgres://user:password@host:port/dbname
